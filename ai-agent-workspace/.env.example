# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_agent_workspace
# For SQLite development: DATABASE_URL=sqlite:///./dev.db

# JWT Settings
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://localhost:1420

# File Storage
FILE_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE=10485760

# Environment (development, staging, production)
ENVIRONMENT=development

# Super Admin Credentials (for initial seed)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
